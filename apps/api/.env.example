# FundsLink API — copy to apps/api/.env (gitignored). NEVER commit real secrets (S3.20 / CF-04).
ENVIRONMENT=development

# PostgreSQL — auth, roles, applications, funding amounts (S5.3 / S5.4)
# In every deployed env this MUST authenticate as the non-owner role fundslink_app
# (handoff contract #1) — the owner role is for migrations only.
DATABASE_URL=postgresql+asyncpg://fundslink:fundslink@localhost:5432/fundslink

# MongoDB — AI-generated reasoning, tags (S5.33)
MONGODB_URL=mongodb://fundslink:fundslink@localhost:27017/fundslink?authSource=admin

# ChromaDB — scholarship embeddings, RAG context (S5.45)
CHROMADB_URL=http://localhost:8001

# Redis — token deny-list, circuit breaker
REDIS_URL=redis://localhost:6379/0

# RS256 JWT (S3.13) — generate a keypair; the private key is a secret
RS256_PRIVATE_KEY=
RS256_PUBLIC_KEY=
# During a key rotation only (ST-2.9 runbook): the PREVIOUS public key, so in-flight tokens
# still verify through the overlap window. Leave empty when not rotating.
RS256_PUBLIC_KEY_PREVIOUS=
# Token lifetimes (seconds) — defaults: access 15 min, refresh 7 days (TAD §3.1)
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800

# Password hashing (S3.3)
BCRYPT_ROUNDS=12

# PII field encryption (TAD §4.4) — AES-256-GCM; base64 of 32 random bytes. SECRET.
PII_ENCRYPTION_KEY=

# CORS — Angular origin(s), comma-separated; no wildcard in production (S3.29)
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Observability
SENTRY_DSN=

# AI embeddings for matching — used when the matching module lands
OPENAI_API_KEY=
